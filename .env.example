# =============================================================================
# Agentic Zero Trust Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# NEVER commit your .env file. It is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# -----------------------------------------------------------------------------
# Azure Identity (Service Principal)
# Used for authenticating to Azure resources via the DefaultAzureCredential
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# -----------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ztplatform:ztplatform_secret@localhost:5432/zerotrust_db
POSTGRES_DB=zerotrust_db
POSTGRES_USER=ztplatform
POSTGRES_PASSWORD=ztplatform_secret

# -----------------------------------------------------------------------------
# OpenSearch (Vector Store and Full-Text Search)
# -----------------------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=zerotrust

# -----------------------------------------------------------------------------
# OPA Policy Engine
# The Zero Trust policy evaluation endpoint
# -----------------------------------------------------------------------------
OPA_URL=http://opa:8181
OPA_POLICY_PATH=/v1/data/zerotrust/allow

# -----------------------------------------------------------------------------
# JWT Authentication
# JWT_SECRET_KEY must be at least 32 characters long
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Redis (Caching and Session Store)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# OpenTelemetry Observability
# -----------------------------------------------------------------------------
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agentic-zero-trust-platform
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# -----------------------------------------------------------------------------
# Application Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Azure AI Search (Knowledge Base)
# -----------------------------------------------------------------------------
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_KEY=your-azure-ai-search-api-key
AZURE_AI_SEARCH_INDEX=agents-knowledge

# -----------------------------------------------------------------------------
# Azure Service Bus (Event Streaming)
# Used for policy violation events and agent audit trail
# -----------------------------------------------------------------------------
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-shared-access-key=

# -----------------------------------------------------------------------------
# Azure Key Vault (Secrets Management)
# At runtime, application secrets are pulled from Key Vault
# -----------------------------------------------------------------------------
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your-application-secret-key-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_AUDIT_LOG=true
ENABLE_POLICY_CACHE=true
POLICY_CACHE_TTL_SECONDS=300
