{
  "title": "Zero Trust Platform Overview",
  "uid": "zt-platform-v1",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Policy Evaluations Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(policy_evaluations_total[1m])",
          "legendFormat": "evaluations/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 2,
      "title": "Allow vs Deny Distribution",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(policy_evaluations_total{decision=\"allow\"}[1h]))",
          "legendFormat": "Allow",
          "refId": "A"
        },
        {
          "expr": "sum(increase(policy_evaluations_total{decision=\"deny\"}[1h]))",
          "legendFormat": "Deny",
          "refId": "B"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": {"displayMode": "table", "placement": "right"}
      }
    },
    {
      "id": 3,
      "title": "P95 Policy Eval Latency",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(policy_evaluation_duration_seconds_bucket[5m]))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.2}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Agent Sessions",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "sum(agent_sessions_active)",
          "legendFormat": "Active Sessions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Posture Score Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "agent_posture_score",
          "legendFormat": "Posture Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "bucketSize": "auto",
        "fillOpacity": 80
      }
    },
    {
      "id": 6,
      "title": "JIT Access Requests",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "rate(jit_access_requests_total{status=\"approved\"}[5m])",
          "legendFormat": "Approved",
          "refId": "A"
        },
        {
          "expr": "rate(jit_access_requests_total{status=\"denied\"}[5m])",
          "legendFormat": "Denied",
          "refId": "B"
        },
        {
          "expr": "rate(jit_access_requests_total{status=\"expired\"}[5m])",
          "legendFormat": "Expired",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    }
  ]
}
