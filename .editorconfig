root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python source files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# YAML configuration files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Terraform infrastructure files
[*.tf]
indent_style = space
indent_size = 2

[*.tfvars]
indent_style = space
indent_size = 2

# JSON data files
[*.json]
indent_style = space
indent_size = 2

# TOML configuration files
[*.toml]
indent_style = space
indent_size = 4

# Markdown documentation
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 4

# Rego policy files (Open Policy Agent)
[*.rego]
indent_style = space
indent_size = 4

# HTML templates
[*.html]
indent_style = space
indent_size = 2
